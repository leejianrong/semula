# ./init.sh writes this file as .env with fresh secrets. Never commit .env.

# The name that points at this machine (ports 80 and 443 open). "localhost" is for a local trial.
SEMULA_DOMAIN=semula.example.com

# Every call to /v1, /api and /mcp needs this key (Authorization: Bearer <key>). Make one with
# `openssl rand -hex 32`. With a key set the dashboard is off (a browser cannot send it).
SEMULA_API_KEY=

# record: a call semula has not seen waits for an agent to answer it. replay: it never waits.
SEMULA_MODE=record

# Which image. Pin a version once you have one you trust. A fork sets SEMULA_REPO to its own.
SEMULA_REPO=ghcr.io/leejianrong/semula
SEMULA_VERSION=latest

# Only for compose.postgres.yaml. Hex, because it goes into a connection URL.
POSTGRES_PASSWORD=

# Only for a trial on a machine that already uses 80 and 443
# HTTP_PORT=8080
# HTTPS_PORT=8443
