# Copy to .env (never commit it). Make each secret with: openssl rand -hex 32
# Use hex for the two database passwords: they go into a connection URL.
SEMULA_DOMAIN=semula.example.com
# The two Postgres passwords are for compose.yaml only; compose.sqlite.yaml ignores them.
POSTGRES_OWNER_PASSWORD=
SEMULA_DB_PASSWORD=
SEMULA_SECRET=

# Which image to run. Pin a version once you have one you trust.
# SEMULA_IMAGE=ghcr.io/leejianrong/semula:0.4.0-hosted

# Sign-in (leave empty until the apps are registered: see docs/guide/hosted.md)
# SEMULA_AUTH_PROVIDERS=google,github
# SEMULA_AUTH_GOOGLE_CLIENT_ID=
# SEMULA_AUTH_GOOGLE_CLIENT_SECRET=
# SEMULA_AUTH_GITHUB_CLIENT_ID=
# SEMULA_AUTH_GITHUB_CLIENT_SECRET=

# Only for a trial on a machine that already uses 80 and 443
# HTTP_PORT=8080
# HTTPS_PORT=8443
