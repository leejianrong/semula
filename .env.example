# Copy to .env (git-ignored) and fill in. semula reads real environment variables only, so start it
# with the file loaded:
#
#   uv run --env-file .env semula serve --port 8765
#
# Never commit .env. The upstream key is read from the server's environment and is never stored,
# logged, exported or shown in an error (docs/adr/0013-record-through-and-its-budget.md).

# Where the server keeps its database. Keep a record-through trial apart from other data.
SEMULA_DATA_DIR=./data/trial

# Start in record mode so a miss parks for an agent, or is forwarded by a project that opted in.
SEMULA_MODE=record

# --- Record-through to a real provider (SEM-92, SEM-93) -------------------------------------
# OpenRouter. Any OpenAI-compatible provider works: change the URL and the key.
SEMULA_UPSTREAM_URL=https://openrouter.ai/api/v1
SEMULA_UPSTREAM_KEY=
# SEMULA_UPSTREAM_TIMEOUT=120

# The answerer hook (docs/guide/service.md): a JSON argv that answers each parked call in a
# project with "answerer" on. Run with tools off. Never put a secret in the argv; use _ENV.
# SEMULA_ANSWERER_COMMAND=["claude","-p","Answer as the model the app calls would."]
# SEMULA_ANSWERER_ENV=ANTHROPIC_API_KEY
# SEMULA_ANSWERER_TIMEOUT=120

# After the server is up, opt a project in (and cap it) with the CLI, for example:
#   semula project create trial
#   semula project settings trial --set '{"mode":"record","record_through":true,"upstream_model":"openai/gpt-4o-mini","upstream_max_calls":20,"upstream_dry_run":true}'
#   (call it, then: semula project upstream trial   lists what a dry run would send)
#   semula project settings trial --set '{"upstream_dry_run":null}'    # forward for real
