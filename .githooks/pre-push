#!/usr/bin/env bash
# Fast pre-push gate: mirrors the cheap CI jobs (lint, types, no-infra tests).
# Bypass once with:  git push --no-verify
set -euo pipefail

echo "pre-push: ruff + mypy + fast tests"
uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run pytest -m "unit or integration" -q
echo "pre-push: ok"
